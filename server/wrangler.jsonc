{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mirumi-me",
  "main": "src/main.ts",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  // mirumi.me の DNS は AWS 側にあるため、本番 API もカスタムドメインは使わない
  "workers_dev": true,
  "send_metrics": false,
  "env": {
    "dev": {
      "name": "mirumi-me-dev",
      "preview_urls": false,
      "upload_source_maps": true,
      "vars": {
        "APP_ENV": "dev",
        "ACCESS_PREVIEW_AUD": "84cc688b6267419444da69a5a070b1043a8e1de0cf4c072d5affcd4ec779b239",
        "ACCESS_ADMIN_AUD": "e42b095901abf896e6644ac39a5b908113f7e4b6ba488f6f765468a9db76a44d",
        "ACCESS_LOCAL_DEV_AUD": "08b4968d3582797438fb4bfea6812763ee7ec11f3ef1396ea0edcf1fa09b8afc",
        "ACCESS_TEAM_DOMAIN": "https://little-mud-182a.cloudflareaccess.com",
        "NOTION_POSTS_DATA_SOURCE_ID": "3c065425-ad40-811a-b50b-000b9271df2c",
        "NOTION_PAGES_DATA_SOURCE_ID": "dc065425-ad40-8391-8e64-87fc27e80a3a",
        "NOTION_INTERNAL_STATE_PROPERTY_ID": "o=BU",
        "NOTION_COMMENTS_DATA_SOURCE_ID": "3d365425-ad40-8100-9705-000ba2e7afec",
        // comments の status / 本文 / 投稿者名 / 親コメント の property ID（decode 済みの値。API の応答は
        // URL encode されているが、照合時に両方 decode する）。dev と prd で値は違う
        "NOTION_COMMENT_STATE_PROPERTY_ID": "}iwL",
        "NOTION_COMMENT_CONTENT_PROPERTY_ID": "=xPq",
        "NOTION_COMMENT_AUTHOR_PROPERTY_ID": "title",
        "NOTION_COMMENT_PARENT_PROPERTY_ID": "J=Mc",
        "WORKERS_API_ORIGIN": "https://mirumi-me-dev.v2p04rubfuwnvttj.workers.dev",
        "FRONTEND_ORIGIN": "https://d3694gpnjd4x49.cloudfront.net",
        "AMAZON_CREATORS_MARKETPLACE": "www.amazon.co.jp",
        "AMAZON_ASSOCIATE_TAG": "milmemo-22",
        "AMAZON_CREATORS_CREDENTIAL_VERSION": "3.3",
        "XAI_MODEL": "grok-4.6",
        "AWS_REGION": "ap-northeast-1",
        "SITE_BUCKET_NAME": "mirumime-dev-mirumi-me",
        "BACKUP_BUCKET_NAME": "mirumime-dev-backup",
        "MEDIA_BUCKET_NAME": "mirumime-prd-mirumi-media",
        "CLOUDFRONT_DISTRIBUTION_ID": "E16GU2ZPNLT91U", // サイト用
        "SES_REGION": "us-east-1", // mirumi.me の SES（DKIM 済み）は us-east-1 にしかない
        "COMMENT_DIGEST_SENDER": "mail@mirumi.me"
      },
      "secrets": {
        "required": [
          "NOTION_TOKEN", // わけてる
          "NOTION_WEBHOOK_SECRET", // わけてる
          "TURNSTILE_SECRET",
          "SES_ACCESS_KEY_ID", // ses:SendEmail だけを許した専用 IAM ユーザー
          "SES_SECRET_ACCESS_KEY", // 同上
          "COMMENT_DIGEST_RECIPIENT", // digest の宛先。public repo に個人アドレスを置かないため secret
          "AMAZON_CARD_SIGNING_SECRET", // わけてる
          "AMAZON_CREATORS_CREDENTIAL_ID", // dev/prd で同じ
          "AMAZON_CREATORS_CREDENTIAL_SECRET", // dev/prd で同じ
          "THUMBNAIL_FUNCTION_URL", // わけてる
          "AWS_ACCESS_KEY_ID", // dev/prd で同じ
          "AWS_SECRET_ACCESS_KEY", // dev/prd で同じ
          "XAI_API_KEY" // dev/prd で同じ
        ]
      },
      "observability": {
        "logs": {
          "enabled": true,
          "invocation_logs": true
        }
      },
      "triggers": {
        // 00:00 UTC = 09:00 JST はコメント digest、19:00 UTC = 04:00 JST は Notion の定期バックアップ
        "crons": ["0 0 * * *", "0 19 * * *"]
      },
      "workflows": [
        {
          "name": "mirumi-me-publish-dev",
          "binding": "PUBLISH_WORKFLOW",
          "class_name": "PublishWorkflow"
        },
        {
          "name": "mirumi-me-comment-refresh-dev",
          "binding": "COMMENT_REFRESH_WORKFLOW",
          "class_name": "CommentRefreshWorkflow"
        },
        {
          "name": "mirumi-me-backup-dev",
          "binding": "BACKUP_WORKFLOW",
          "class_name": "BackupWorkflow"
        }
      ],
      "containers": [
        {
          "name": "mirumi-me-build-dev",
          "image": "./src/containers/Dockerfile",
          "image_build_context": "..",
          "class_name": "BuildContainer",
          "max_instances": 1,
          "instance_type": "standard-3",
          "constraints": {
            "regions": ["APAC"]
          },
          "rollout_step_percentage": 100,
          "ssh": {
            "enabled": false
          }
        }
      ],
      // Containers の使用に必要
      "durable_objects": {
        "bindings": [
          {
            "name": "BUILD_CONTAINER",
            "class_name": "BuildContainer"
          }
        ]
      },
      // Containers の使用に必要
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["BuildContainer"]
        }
      ],
      "analytics_engine_datasets": [
        {
          "dataset": "mirumi_me_pv_dev",
          "binding": "MIRUMI_ME_PV"
        }
      ],
      "ratelimits": [
        {
          "name": "RATE_LIMITER_60_PER_MINUTE",
          "namespace_id": "913240001",
          "simple": {
            "limit": 60,
            "period": 60
          }
        },
        // コメント投稿の IP 単位の補助制限。スパム対策の主役は Turnstile
        {
          "name": "RATE_LIMITER_COMMENTS",
          "namespace_id": "913240003",
          "simple": {
            "limit": 5,
            "period": 60
          }
        }
      ],
      "kv_namespaces": [
        {
          "id": "ab630ddb5e9144c986d766ca9f7e454e",
          "binding": "CONTENT_CACHE"
        }
      ],
      "r2_buckets": [
        {
          "bucket_name": "mirumi-me-backup-dev",
          "binding": "BACKUP"
        }
      ]
    },
    "prd": {
      "name": "mirumi-me-prd",
      "preview_urls": false,
      "upload_source_maps": false,
      "vars": {
        "APP_ENV": "prd",
        "ACCESS_PREVIEW_AUD": "84cc688b6267419444da69a5a070b1043a8e1de0cf4c072d5affcd4ec779b239",
        "ACCESS_ADMIN_AUD": "e42b095901abf896e6644ac39a5b908113f7e4b6ba488f6f765468a9db76a44d",
        "ACCESS_TEAM_DOMAIN": "https://little-mud-182a.cloudflareaccess.com",
        "NOTION_POSTS_DATA_SOURCE_ID": "399e5acd-5762-442b-a3f5-be983498d926",
        "NOTION_PAGES_DATA_SOURCE_ID": "53765425-ad40-828e-976a-0789d64d4dee",
        "NOTION_INTERNAL_STATE_PROPERTY_ID": "o=BU",
        "NOTION_COMMENTS_DATA_SOURCE_ID": "201f8de6-3bca-4731-b19e-592fc87af528",
        // comments の status / 本文 / 投稿者名 / 親コメント の property ID。prd の schema を dev と同じ構成に
        // 作ってから埋める（値は dev と違う）。空のままだとコメント関連の Webhook は無視される🔴
        "NOTION_COMMENT_STATE_PROPERTY_ID": "",
        "NOTION_COMMENT_CONTENT_PROPERTY_ID": "",
        "NOTION_COMMENT_AUTHOR_PROPERTY_ID": "",
        "NOTION_COMMENT_PARENT_PROPERTY_ID": "",
        "WORKERS_API_ORIGIN": "https://mirumi-me-prd.v2p04rubfuwnvttj.workers.dev",
        "FRONTEND_ORIGIN": "https://mirumi.me",
        "AMAZON_CREATORS_MARKETPLACE": "www.amazon.co.jp",
        "AMAZON_ASSOCIATE_TAG": "milmemo-22",
        "AMAZON_CREATORS_CREDENTIAL_VERSION": "3.3",
        "XAI_MODEL": "grok-4.6",
        "AWS_REGION": "ap-northeast-1",
        "SITE_BUCKET_NAME": "mirumime-prd-mirumi-me",
        "BACKUP_BUCKET_NAME": "mirumime-prd-backup",
        "MEDIA_BUCKET_NAME": "mirumime-prd-mirumi-media",
        "CLOUDFRONT_DISTRIBUTION_ID": "E1UPWIMHFP5TEC", // サイト用
        "SES_REGION": "us-east-1", // mirumi.me の SES（DKIM 済み）は us-east-1 にしかない
        "COMMENT_DIGEST_SENDER": "mail@mirumi.me"
      },
      "secrets": {
        "required": [
          "NOTION_TOKEN",
          "NOTION_WEBHOOK_SECRET",
          "TURNSTILE_SECRET",
          "SES_ACCESS_KEY_ID", // ses:SendEmail だけを許した専用 IAM ユーザー
          "SES_SECRET_ACCESS_KEY", // 同上
          "COMMENT_DIGEST_RECIPIENT", // digest の宛先。public repo に個人アドレスを置かないため secret
          "AMAZON_CARD_SIGNING_SECRET",
          "AMAZON_CREATORS_CREDENTIAL_ID",
          "AMAZON_CREATORS_CREDENTIAL_SECRET",
          "THUMBNAIL_FUNCTION_URL",
          "AWS_ACCESS_KEY_ID",
          "AWS_SECRET_ACCESS_KEY",
          "XAI_API_KEY"
        ]
      },
      "observability": {
        "logs": {
          "enabled": true,
          "invocation_logs": true
        }
      },
      "triggers": {
        // 00:00 UTC = 09:00 JST はコメント digest、19:00 UTC = 04:00 JST は Notion の定期バックアップ
        "crons": ["0 0 * * *", "0 19 * * *"]
      },
      "workflows": [
        {
          "name": "mirumi-me-publish-prd",
          "binding": "PUBLISH_WORKFLOW",
          "class_name": "PublishWorkflow"
        },
        {
          "name": "mirumi-me-comment-refresh-prd",
          "binding": "COMMENT_REFRESH_WORKFLOW",
          "class_name": "CommentRefreshWorkflow"
        },
        {
          "name": "mirumi-me-backup-prd",
          "binding": "BACKUP_WORKFLOW",
          "class_name": "BackupWorkflow"
        }
      ],
      "containers": [
        {
          "name": "mirumi-me-build-prd",
          "image": "./src/containers/Dockerfile",
          "image_build_context": "..",
          "class_name": "BuildContainer",
          "max_instances": 1,
          "instance_type": "standard-3",
          "constraints": {
            "regions": ["APAC"]
          },
          "rollout_step_percentage": 100,
          "ssh": {
            "enabled": false
          }
        }
      ],
      // Containers の使用に必要
      "durable_objects": {
        "bindings": [
          {
            "name": "BUILD_CONTAINER",
            "class_name": "BuildContainer"
          }
        ]
      },
      // Containers の使用に必要
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["BuildContainer"]
        }
      ],
      "analytics_engine_datasets": [
        {
          "dataset": "mirumi_me_pv_prd",
          "binding": "MIRUMI_ME_PV"
        }
      ],
      "ratelimits": [
        {
          "name": "RATE_LIMITER_60_PER_MINUTE",
          "namespace_id": "913240002",
          "simple": {
            "limit": 60,
            "period": 60
          }
        },
        // コメント投稿の IP 単位の補助制限。スパム対策の主役は Turnstile
        {
          "name": "RATE_LIMITER_COMMENTS",
          "namespace_id": "913240004",
          "simple": {
            "limit": 5,
            "period": 60
          }
        }
      ],
      "kv_namespaces": [
        {
          // prd の KV namespace をつくったら入れる、未設定だと deploy が通らない🔴
          // "id": "",
          "binding": "CONTENT_CACHE"
        }
      ],
      "r2_buckets": [
        {
          "bucket_name": "mirumi-me-backup-prd",
          "binding": "BACKUP"
        }
      ]
    }
  }
}
