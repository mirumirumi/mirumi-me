{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mirumi-me",
  "main": "src/main.ts",
  "compatibility_date": "2026-08-12",
  // mirumi.me の DNS は AWS 側にあるため、本番 API もカスタムドメインは使わない
  "workers_dev": true,
  "send_metrics": false,
  "env": {
    "dev": {
      "name": "mirumi-me-dev",
      "preview_urls": false,
      "upload_source_maps": true,
      "vars": {
        "APP_ENV": "dev",
        "ACCESS_AUD": "84cc688b6267419444da69a5a070b1043a8e1de0cf4c072d5affcd4ec779b239",
        "ACCESS_TEAM_DOMAIN": "https://little-mud-182a.cloudflareaccess.com",
        "AWS_REGION": "ap-northeast-1",
        "SITE_BUCKET_NAME": "mirumime-dev-mirumi-me",
        "CLOUDFRONT_DISTRIBUTION_ID": "E16GU2ZPNLT91U"
      },
      "secrets": {
        "required": [
          "NOTION_TOKEN",
          "NOTION_WEBHOOK_SECRET",
          "TURNSTILE_SECRET",
          "AWS_ACCESS_KEY_ID",
          "AWS_SECRET_ACCESS_KEY",
          "XAI_API_KEY"
        ]
      },
      "triggers": {
        // バックアップ頻度が決まったら書く🔴
        "crons": []
      },
      "workflows": [
        {
          "name": "mirumi-me-publish-dev",
          "binding": "PUBLISH_WORKFLOW",
          "class_name": "PublishWorkflow"
        }
      ],
      "containers": [
        {
          "name": "mirumi-me-build-dev",
          "image": "./src/containers/Dockerfile",
          "image_build_context": "..",
          "class_name": "BuildContainer",
          "max_instances": 1,
          "instance_type": "standard-3",
          "constraints": {
            "regions": ["APAC"]
          },
          "rollout_step_percentage": 100,
          "ssh": {
            "enabled": false
          }
        }
      ],
      // Containers の使用に必要
      "durable_objects": {
        "bindings": [
          {
            "name": "BUILD_CONTAINER",
            "class_name": "BuildContainer"
          }
        ]
      },
      // Containers の使用に必要
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["BuildContainer"]
        }
      ],
      "analytics_engine_datasets": [
        {
          "dataset": "mirumi_me_pv_dev",
          "binding": "MIRUMI_ME_PV"
        }
      ],
      "kv_namespaces": [
        {
          "id": "ab630ddb5e9144c986d766ca9f7e454e",
          "binding": "X_POST_CACHE"
        }
      ],
      "r2_buckets": [
        {
          "bucket_name": "mirumi-me-backup-dev",
          "binding": "BACKUP"
        }
      ]
    },
    "prd": {
      "name": "mirumi-me-prd",
      "preview_urls": false,
      "upload_source_maps": false,
      "vars": {
        "APP_ENV": "prd",
        "ACCESS_AUD": "84cc688b6267419444da69a5a070b1043a8e1de0cf4c072d5affcd4ec779b239",
        "ACCESS_TEAM_DOMAIN": "https://little-mud-182a.cloudflareaccess.com",
        "AWS_REGION": "ap-northeast-1",
        "SITE_BUCKET_NAME": "mirumime-prd-mirumi-me",
        "CLOUDFRONT_DISTRIBUTION_ID": "E1UPWIMHFP5TEC"
      },
      "secrets": {
        "required": [
          "NOTION_TOKEN",
          "NOTION_WEBHOOK_SECRET",
          "TURNSTILE_SECRET",
          "AWS_ACCESS_KEY_ID",
          "AWS_SECRET_ACCESS_KEY",
          "XAI_API_KEY"
        ]
      },
      "triggers": {
        // バックアップ頻度が決まったら書く🔴
        "crons": []
      },
      "workflows": [
        {
          "name": "mirumi-me-publish-prd",
          "binding": "PUBLISH_WORKFLOW",
          "class_name": "PublishWorkflow"
        }
      ],
      "containers": [
        {
          "name": "mirumi-me-build-prd",
          "image": "./src/containers/Dockerfile",
          "image_build_context": "..",
          "class_name": "BuildContainer",
          "max_instances": 1,
          "instance_type": "standard-3",
          "constraints": {
            "regions": ["APAC"]
          },
          "rollout_step_percentage": 100,
          "ssh": {
            "enabled": false
          }
        }
      ],
      // Containers の使用に必要
      "durable_objects": {
        "bindings": [
          {
            "name": "BUILD_CONTAINER",
            "class_name": "BuildContainer"
          }
        ]
      },
      // Containers の使用に必要
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["BuildContainer"]
        }
      ],
      "analytics_engine_datasets": [
        {
          "dataset": "mirumi_me_pv_prd",
          "binding": "MIRUMI_ME_PV"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "X_POST_CACHE"
        }
      ],
      "r2_buckets": [
        {
          "bucket_name": "mirumi-me-backup-prd",
          "binding": "BACKUP"
        }
      ]
    }
  }
}
