{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "tsc": "tsc --noEmit",
    "type:check": "wrangler types --check --env-interface CloudflareBindings",
    "type:gen": "wrangler types --env-interface CloudflareBindings",
    "test": "vitest run --config ../vitest.config.ts --configLoader runner server",
    "deploy:dev": "wrangler deploy --minify --env dev",
    "deploy:prd": "wrangler deploy --minify --env prd"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.1116.0",
    "@aws-sdk/client-s3": "^3.1116.0",
    "@cloudflare/containers": "^0.3.7",
    "hono": "^4.13.1",
    "jose": "^6.2.10",
    "shared": "workspace:*",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "wrangler": "^4.121.0"
  }
}
