{
  "files": {
    "includes": [
      "**",
      "!**/*.json",
      "!**/nuxt.config.ts",
      "!**/.nuxt",
      "!!**/.output",
      "!!**/public/assets/components",
      "!!**/public/assets/prism.js",
      "!!**/dist",
      "!**/tools",
      "!**/worker-configuration.d.ts",
      "!**/.wrangler"
    ]
  },
  "linter": {
    "rules": {
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "off",
        "noUselessElse": "off",
        "useImportType": "off"
      },
      "complexity": {
        "noForEach": "off"
      },
      "correctness": {
        "noUnusedImports": "off",
        "noUnusedVariables": "off",
        "noUnusedFunctionParameters": "off"
      },
      "suspicious": {
        "noExplicitAny": "warn"
      },
      "a11y": {
        "noSvgWithoutTitle": "off"
      }
    }
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [
                ":URL:",
                ":BUN:",
                ":NODE:",
                ":PACKAGE_WITH_PROTOCOL:",
                {
                  "source": [":PACKAGE:", "!shared", "!shared/**"]
                }
              ],
              ":BLANK_LINE:",
              ["shared", "shared/**"],
              ":BLANK_LINE:",
              [":ALIAS:", ":PATH:"]
            ]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded"
    },
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "json": {
    "parser": {
      "allowComments": true
    }
  }
}
