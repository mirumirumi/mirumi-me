{
    "name": "site-admin-extension",
    "version": "1.0.0",
    "manifest_version": 3,
    "description": "for mirumi.me",
    "icons": {
        "32": "icons/icon_32.png",
        "48": "icons/icon_48.png",
        "128": "icons/icon_128.png"
    },
    "background": {
        "service_worker": "src/background.ts",
        "type": "module"
    },
    "host_permissions": [
        "https://api.cloudflare.com/*",
        "https://api.notion.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://mirumi.me/*",
                "https://d3unw9ju8hrt73.cloudfront.net/*",
                "https://d3694gpnjd4x49.cloudfront.net/*"
            ],
            "js": [
                "src/content-script.ts"
            ]
        }
    ]
}
